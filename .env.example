# Configuration reference; not usable production credentials.
# Recommended: sudo bash scripts/install-ubuntu.sh --domain idealmako.ir --email YOUR_EMAIL
# The installer creates required secrets once in shared/.env with mode 600.
# Manual setup: generate independent passwords with openssl rand -hex 32, then
# assemble DATABASE_URL and MIGRATION_DATABASE_URL using the matching passwords.

COMPOSE_PROJECT_NAME=idealmakoo
INSTALL_ROOT=/var/www/idealmakoo-v2
COMPOSE_PROFILES=antivirus
APP_IMAGE=idealmakoo-app:local
PROXY_IMAGE=idealmakoo-proxy:local
NODE_IMAGE=node:24-bookworm-slim
POSTGRES_IMAGE=pgvector/pgvector:pg16
CADDY_IMAGE=caddy:2-alpine
CLAMAV_IMAGE=clamav/clamav:stable_base
CLAMAV_RUNTIME_IMAGE=idealmakoo-clamav:local
RELEASE_SHA=local
# Optional corporate build CA, only with the explicit compose.build-ca.yml
# override. BuildKit mounts it for npm steps; it never enters the runtime image.
BUILD_CA_CERT_FILE=

POSTGRES_DB=idealmakoo
POSTGRES_ADMIN_PASSWORD=
POSTGRES_APP_PASSWORD=
POSTGRES_MIGRATION_PASSWORD=
DATABASE_URL=
MIGRATION_DATABASE_URL=
DATABASE_APP_ROLE=idealmakoo_app
DATABASE_SSL=false
DB_POOL_SIZE=10
# URL shape (angle brackets are explanatory, not literal configuration):
# postgresql://idealmakoo_app:<APP_PASSWORD>@db:5432/idealmakoo
# postgresql://idealmakoo_owner:<MIGRATION_PASSWORD>@db:5432/idealmakoo

NODE_ENV=production
SESSION_SECRET=
SESSION_IDLE_MINUTES=60
SESSION_HOURS=24
# Exactly 64 hexadecimal characters; preserve this key for MFA decryption.
MFA_ENCRYPTION_KEY=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=مدیر سامانه
# Confidential quality access is explicit even for the initial administrator.
BOOTSTRAP_ADMIN_QUALITY_SCOPE=false
# hybrid initializes staff from the protected environment and permits audited
# administration in the panel; ordinary seed/provisioning preserves those edits.
# env explicitly locks staff grants/invitations to the owner provisioning command.
STAFF_PROVISIONING_MODE=hybrid
# Owner/seed/provisioner only: never pass this JSON or bootstrap passwords to app
# or worker. Each record requires key,email,name,role,allowedLocales; new staff
# also need a unique random password (12–128 characters). See STAFF-ENV.fa.md.
# First seed creates configured accounts; reruns do NOT reset grants/passwords.
STAFF_ACCOUNTS_JSON=[]

SITE_URL=https://idealmako.ir
SITE_ADDRESS=idealmako.ir
NEXT_PUBLIC_SITE_URL=https://idealmako.ir
NEXT_PUBLIC_DATA_MODE=api
NEXT_PUBLIC_DEMO_MODE=false
DEMO_MODE=false
ACME_EMAIL=
BIND_IP=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
STORAGE_DIR=/app/storage
STORAGE_QUOTA_BYTES=10737418240
STORAGE_USER_QUOTA_BYTES=1073741824
STORAGE_GUEST_QUOTA_BYTES=104857600
# Initial defaults only; after seed, administrators edit the versioned policy
# in Settings / storage limits. Bytes, not decimal MB. Hard ceiling80MiB/file.
UPLOAD_MAX_FILE_BYTES=20971520
UPLOAD_MAX_IMAGE_BYTES=20971520
UPLOAD_MAX_DOCUMENT_BYTES=20971520
UPLOAD_MAX_VIDEO_BYTES=20971520
UPLOAD_MAX_AUDIO_BYTES=20971520
# Bounds memory used by multipart/image processing per web process (1–8).
UPLOAD_CONCURRENT_REQUESTS=2
# A separate durable host directory, outside uploaded media and ordinary backups.
# The installer creates it with owner 10001:10001 and mode 700. Never replace it
# with an older database backup: its signed erasure history must survive restores.
PRIVACY_LEDGER_HOST_DIR=/var/lib/idealmakoo-privacy/idealmakoo
PRIVACY_LEDGER_DIR=/app/privacy-ledger
# Empty directory is sufficient when push is disabled. Read-only in containers.
INTEGRATIONS_HOST_DIR=/var/www/idealmakoo/integrations
# true ONLY behind the isolated trusted reverse proxy; false for direct Next.
TRUST_PROXY=true

# disabled prevents outbound messages. live requires real provider credentials.
NOTIFICATIONS_MODE=disabled
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_DKIM_MODE=off
SMTP_DKIM_DOMAIN=
SMTP_DKIM_SELECTOR=
SMTP_DKIM_PRIVATE_KEY_B64=
CRM_CAMPAIGNS_ENABLED=false
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
KAVENEGAR_OTP_TEMPLATE=
# Required server-only push credential; official apiKey header, verified 2026-10-19:
# https://www.najva.com/api-docs/ (token-send multipart sample).
NAJVA_API_KEY=
# Blank or exactly https://push.najva.com/v1/send/token/.
# Token requests include website_id and the server-only apiKey header.
NAJVA_API_URL=
NAJVA_WEBSITE_ID=
NAJVA_SDK_URL=
# Optional /app/integrations/najva-messaging-sw.js supplied by the operator.
NAJVA_WORKER_FILE=
# Up to 8 exact HTTPS najva.com/subdomain origins; no paths or wildcards.
# Expand CSP only for the exact verification popup and root push worker.
NAJVA_SCRIPT_ORIGINS=
NAJVA_CONNECT_ORIGINS=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_CHANNEL_ID=
TELEGRAM_CHANNEL_LOCALES=fa

# Configure a real key and an explicitly selected model to enable an AI capability.
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_TEXT_MODEL=
OPENROUTER_IMAGE_MODEL=
OPENROUTER_VIDEO_MODEL=
OPENROUTER_AUDIO_MODEL=
OPENROUTER_AUDIO_VOICE=
OPENROUTER_WEBHOOK_SECRET=
GOOGLE_API_KEY=
GOOGLE_TEXT_MODEL=
GOOGLE_IMAGE_MODEL=
# Legacy Google names remain supported; prefer the canonical GOOGLE_* names above.
GOOGLE_AI_API_KEY=
GOOGLE_AI_TEXT_MODEL=
GOOGLE_AI_IMAGE_MODEL=
AI_DAILY_BUDGET_USD=5
AI_MONTHLY_BUDGET_USD=100
AI_REQUEST_RESERVE_USD=1
AI_VIDEO_RESERVE_USD=10
AI_AUDIO_RESERVE_USD=1
AI_PUBLIC_CHAT=false
RAG_ENABLED=false
RAG_EMBEDDING_MODEL=
# Supported index dimensions: 768, 1024 or 1536; must match the selected model.
RAG_EMBEDDING_DIMENSIONS=768
RAG_REQUEST_RESERVE_USD=0.02

# Local media processing requires a clean, authorized source and explicit job.
MEDIA_PROCESSING_ENABLED=true
MEDIA_PROCESSING_TIMEOUT_SECONDS=120
WORKER_CPUS=2.0
WORKER_MEMORY=2g
# Compose health durations in whole seconds; normal production defaults below.
# Timeout range: app 8..120 / worker 10..120. Start range: app 45..600 / worker 60..600.
# Each start period must be at least its corresponding timeout; checks remain enabled.
APP_HEALTH_TIMEOUT_SECONDS=8
APP_HEALTH_START_PERIOD_SECONDS=45
WORKER_HEALTH_TIMEOUT_SECONDS=10
WORKER_HEALTH_START_PERIOD_SECONDS=60
MONITORING_BROWSER_METRICS_ENABLED=false
MONITORING_INTERNAL_PROBE_URL=http://app:3000
MONITORING_EXTERNAL_PROBES_ENABLED=false

# Non-image uploads stay quarantined until ClamAV actually reports a clean scan.
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=120000

# Managed domain mail is explicit: --with-mail-server or MAIL_SERVER_ENABLED=true.
# Existing SMTP stays external unless the owner explicitly selects local mode.
MAIL_SERVER_MODE=external
MAIL_SERVER_ENABLED=
MAIL_SERVER_IMAGE=ghcr.io/docker-mailserver/docker-mailserver:16.0.1
MAIL_DOMAIN=
MAIL_HOSTNAME=
MAIL_PUBLIC_IP=
MAIL_DATA_DIR=
MAIL_SERVICE_ADDRESS=
MAIL_SERVICE_PASSWORD=
MAIL_MESSAGE_LIMIT_BYTES=26214400
MAIL_MAILBOX_LIMIT_BYTES=1073741824
MAIL_OUTBOUND_ENABLED=true
MAIL_RELAY_HOST=
MAIL_RELAY_PORT=587
MAIL_RELAY_USER=
MAIL_RELAY_PASSWORD=
# HTTPS only; lockfile integrity remains mandatory.
BUILD_NPM_REGISTRY=https://registry.npmjs.org
# local-images requires exact base/database/mail images preloaded, but npm/apt may still need network.
INSTALL_NETWORK_MODE=online
# Optional Node24 fetch proxy for Telegram, AI and other HTTPS APIs.
# Only the app/worker/operations containers use these values. No daemon settings
# or TLS verification are changed. Percent encode credentials in the URL.
# Enable with 1 and set an HTTPS-capable HTTP(S) CONNECT proxy, then recreate.
RUNTIME_USE_ENV_PROXY=0
RUNTIME_HTTP_PROXY=
RUNTIME_HTTPS_PROXY=
# Additional bypass hosts only; internal service/loopback names are always added.
RUNTIME_NO_PROXY=
# Private Xray HTTP proxy used exclusively for Telegram and Google Gemini API calls.
# Keep RUNTIME_USE_ENV_PROXY=0 so no other service uses this tunnel.
SELECTIVE_UPSTREAM_PROXY_URL=
SELECTIVE_PROXY_CONFIG_FILE=
CUSTOMER_SMS_OTP_ENABLED=true
# Public SMS is shortened to this segment limit while preserving its content URL.
SMS_MAX_SEGMENTS=6
# Optional estimate in Iranian rials per SMS segment; actual provider cost is separate.
SMS_ESTIMATED_SEGMENT_COST_IRR=
